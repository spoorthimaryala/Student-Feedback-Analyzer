        "Enter Teacher ID: "
    ).strip()

    password = input(
        "Enter Password: "
    ).strip()

    with open(
        TEACHER_FILE,
        "r",
        newline=""
    ) as file:

        reader = csv.DictReader(file)

        for teacher in reader:

            if (
                teacher["ID"] == teacher_id
                and
                teacher["Password"] == password
            ):

                print(
                    "\nTeacher login successful!"
                )

                print(
                    "Faculty:",
                    teacher["Faculty"]
                )

                print(
                    "Department:",
                    teacher["Department"]
                )

                print(
                    "Section:",
                    teacher["Section"]
                )

                return teacher

    print(
        "Invalid teacher ID or password."
    )

    return None

def view_feedback(teacher):

    dept = teacher["Department"]

    section = teacher["Section"]

    teacher_name = teacher["Faculty"]

    records = []

    with open(
        FEEDBACK_FILE,
        "r",
        newline=""
    ) as file:

        reader = csv.DictReader(file)

        for row in reader:

            if (
                row["Department"] == dept
                and
                row["Section"] == section
                and
                row["Faculty"] == teacher_name
            ):

                records.append(row)

    print(
        "\nFeedback for",
        teacher_name
    )

    print(
        "Department:",
        dept
    )

    print(
        "Section:",
        section
    )

    print("-" * 40)

    if not records:

        print(
            "No feedback available yet."
        )

        return

    ratings = []

    for record in records:

        rating = int(
            record["Rating"]
        )

        ratings.append(rating)

        print(
            "Rating:",
            rating,
            "/5"
        )

        print(
            "Comment:",
            record["Comment"]
        )

        print(
            "Date:",
            record["Date"]
        )

        print("-" * 40)

    average = (
        sum(ratings)
        /
        len(ratings)
    )

    print(
        "Total feedback:",
        len(ratings)
    )

    print(
        "Average rating:",
        round(average, 2),
        "/5"
    )

    rating_counts = [
        ratings.count(i)
        for i in range(1, 6)
    ]

    plt.figure(
        figsize=(7, 4)
    )

    plt.bar(
        [1, 2, 3, 4, 5],
        rating_counts
    )

    plt.xlabel(
        "Rating"
    )

    plt.ylabel(
        "Number of Students"
    )

    plt.title(
        teacher_name
        + " - Rating Distribution"
    )

    plt.xticks(
        [1, 2, 3, 4, 5]
    )

    plt.tight_layout()

    plt.show()

    plt.figure(
        figsize=(6, 4)
    )

    plt.bar(
        [teacher_name],
        [average]
    )

    plt.xlabel(
        "Faculty"
    )

    plt.ylabel(
        "Average Rating"
    )

    plt.title(
        "Average Feedback Rating"
    )

    plt.ylim(
        0,
        5
    )

    plt.tight_layout()

    plt.show()

def student_menu(student):

    while True:

        print(
            "\n===== STUDENT MENU ====="
        )

        print(
            "1. Submit Feedback"
        )

        print(
            "2. Logout"
        )

        choice = input(
            "Enter choice: "
        )

        if choice == "1":

            submit_feedback(student)

        elif choice == "2":

            print(
                "Logged out."
            )

            break

        else:

            print(
                "Invalid choice."
            )

def teacher_menu(teacher):

