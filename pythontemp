        print(
            "2. Teacher Login"
        )

        print(
            "3. Exit"
        )

        choice = input(
            "Enter choice: "
        )

        if choice == "1":

            student = student_login()

            if student:

                student_menu(student)

        elif choice == "2":

            teacher = teacher_login()

            if teacher:

                teacher_menu(teacher)

        elif choice == "3":

            print(
                "Thank you for using the system!"
            )

            break

        else:

            print(
                "Invalid choice."
            )

if __name__ == "__main__":

    main()
