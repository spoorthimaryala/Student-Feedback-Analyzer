def create_students():

    if os.path.exists(STUDENT_FILE):
        return

    with open(STUDENT_FILE, "w", newline="") as file:

        writer = csv.writer(file)

        writer.writerow([
            "ID",
            "Password",
            "Department",
            "Section"
        ])

        for dept in departments:

            for i in range(1, 201):

                student_id = dept + str(1000 + i)

                password = student_id + "@123"

                if i <= 50:
                    section = "A"

                elif i <= 100:
                    section = "B"

                elif i <= 150:
                    section = "C"

                else:
                    section = "D"

                writer.writerow([
                    student_id,
                    password,
                    dept,
                    section
                ])

    print("600 student records created.")
    print("200 students per branch.")
    print("50 students per section.")

def create_teachers():

    if os.path.exists(TEACHER_FILE):
        return

    with open(TEACHER_FILE, "w", newline="") as file:

        writer = csv.writer(file)

        writer.writerow([
            "ID",
            "Password",
            "Department",
            "Section",
            "Faculty"
        ])

        for dept in departments:

            for section in sections:

                for i, name in enumerate(
                    faculty[dept][section],
                    start=1
                ):

                    teacher_id = (
                        dept.lower()
                        + section.lower()
                        + str(i).zfill(2)
                    )

                    password = teacher_id + "@123"

                    writer.writerow([
                        teacher_id,
                        password,
                        dept,
                        section,
                        name
                    ])

    print("72 teacher accounts created.")

def create_feedback_file():

    if not os.path.exists(FEEDBACK_FILE):

        with open(
            FEEDBACK_FILE,
            "w",
            newline=""
        ) as file:

            writer = csv.writer(file)

            writer.writerow([
                "Department",
                "Section",
                "Faculty",
                "Rating",
                "Comment",
                "Date"
            ])

        print("Feedback file created.")

def student_login():

    student_id = input(
        "Enter Student ID: "
    ).strip()

    password = input(
        "Enter Password: "
    ).strip()

    with open(
        STUDENT_FILE,
        "r",
        newline=""
    ) as file:

        reader = csv.DictReader(file)

        for student in reader:

            if (
                student["ID"] == student_id
                and
                student["Password"] == password
            ):

                print(
                    "\nStudent login successful!"
                )

                print(
                    "Department:",
                    student["Department"]
                )

                print(
                    "Section:",
                    student["Section"]
                )

                return student

    print(
        "Invalid ID or password."
    )

    return None

def submit_feedback(student):

    dept = student["Department"]

    section = student["Section"]

    print("\n================================")
    print("       FACULTY FEEDBACK")
    print("================================")

    print(
        "Department:",
        dept
    )

    print(
        "Section:",
        section
    )

    print("--------------------------------")

    section_faculty = faculty[dept][section]

    for teacher_name in section_faculty:

        print("\n--------------------------------")

        print(
            "Faculty:",
            teacher_name
        )

        print("--------------------------------")

        try:

            rating = int(
                input(
                    "Enter rating (1 to 5): "
                )
            )

            if rating < 1 or rating > 5:

                print(
                    "Rating must be between 1 and 5."
                )

                print(
                    "Feedback for this faculty "
                    "was not submitted."
                )

                continue

            comment = input(
                "Enter feedback: "
            ).strip()

            if not comment:

                print(
                    "Feedback cannot be empty."
                )

                print(
                    "Feedback for this faculty "
                    "was not submitted."
                )

                continue

            with open(
                FEEDBACK_FILE,
                "a",
                newline=""
            ) as file:

                writer = csv.writer(file)

                writer.writerow([
                    dept,
                    section,
                    teacher_name,
                    rating,
                    comment,
                    datetime.now().strftime(
                        "%Y-%m-%d %H:%M"
                    )
                ])

            print(
                "Feedback submitted for",
                teacher_name
            )

        except ValueError:

            print(
                "Please enter a valid rating."
            )

    print("\n================================")

    print(
        "All faculty feedback completed!"
    )

    print(
        "Your feedback is anonymous."
    )

    print("================================")

def teacher_login():

